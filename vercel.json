{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "public/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/img/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/regalo/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/.well-known/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/informe/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/consent-pdf.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/icons/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/chat-ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/racha-ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/avisos.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/manifest-fisio.json",
      "use": "@vercel/static"
    },
    {
      "src": "icono.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/consentimiento\\.png",
      "dest": "/api/schedule.js?action=consentimiento-og"
    },
    {
      "src": "/consentimiento",
      "dest": "/api/schedule.js?action=consentimiento"
    },
    {
      "src": "/suelo-pelvico\\.png",
      "dest": "/api/schedule.js?action=cons-otro-og&kind=sp"
    },
    {
      "src": "/suelo-pelvico",
      "dest": "/api/schedule.js?action=cons-otro&kind=sp"
    },
    {
      "src": "/alta-oncologica\\.png",
      "dest": "/api/schedule.js?action=cons-otro-og&kind=alta"
    },
    {
      "src": "/alta-oncologica",
      "dest": "/api/schedule.js?action=cons-otro&kind=alta"
    },
    {
      "src": "/documento/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=cdoc&id=$1&s=$2"
    },
    {
      "src": "/tarjeta/(rec[A-Za-z0-9]{14})\\.png",
      "dest": "/api/schedule.js?action=tarjeta-og&id=$1"
    },
    {
      "src": "/tarjeta/(rec[A-Za-z0-9]{14})",
      "dest": "/api/schedule.js?action=tarjeta-pagina&id=$1"
    },
    {
      "src": "/i/([A-Za-z0-9]{20})",
      "dest": "/api/schedule.js?action=inf-pagina&t=$1"
    },
    {
      "src": "/doc/([A-Za-z0-9]{24})",
      "dest": "/api/schedule.js?action=doc-pagina&t=$1"
    },
    {
      "src": "/a/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.png",
      "dest": "/api/schedule.js?action=app-og&id=$1&s=$2"
    },
    {
      "src": "/a/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=app-pagina&id=$1&s=$2"
    },
    {
      "src": "/h/([A-Za-z0-9_-]+)\\.([a-f0-9]{8})\\.png",
      "dest": "/api/schedule.js?action=huecos-og&k=$1&s=$2"
    },
    {
      "src": "/h/([A-Za-z0-9_-]+)\\.([a-f0-9]{8})",
      "dest": "/api/schedule.js?action=huecos&k=$1&s=$2"
    },
    {
      "src": "/pago/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.png",
      "dest": "/api/schedule.js?action=pago-og&id=$1&s=$2"
    },
    {
      "src": "/pago/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=pago&id=$1&s=$2"
    },
    {
      "src": "/v/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.png",
      "dest": "/api/schedule.js?action=fin-og&id=$1&s=$2"
    },
    {
      "src": "/v/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=fin&id=$1&s=$2"
    },
    {
      "src": "/e/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.png",
      "dest": "/api/schedule.js?action=encuesta-og&id=$1&s=$2"
    },
    {
      "src": "/e/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=encuesta&id=$1&s=$2"
    },
    {
      "src": "/c/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.png",
      "dest": "/api/schedule.js?action=cita-og&id=$1&s=$2"
    },
    {
      "src": "/c/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})\\.ics",
      "dest": "/api/schedule.js?action=cita-ics&id=$1&s=$2"
    },
    {
      "src": "/c/(rec[A-Za-z0-9]{14})-([a-f0-9]{10})",
      "dest": "/api/schedule.js?action=cita-confirmar&id=$1&s=$2"
    },
    {
      "src": "/img/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/img/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/.well-known/assetlinks.json",
      "headers": {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/public/.well-known/assetlinks.json"
    },
    {
      "src": "/regalo/(.*)",
      "dest": "/public/regalo/$1"
    },
    {
      "src": "/informe/(.*)",
      "dest": "/public/informe/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/icons/favicon.ico"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/public/icons/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js"
    },
    {
      "src": "/chat-ui.js",
      "dest": "/public/chat-ui.js"
    },
    {
      "src": "/racha-ui.js",
      "dest": "/public/racha-ui.js"
    },
    {
      "src": "/avisos.js",
      "dest": "/public/avisos.js"
    },
    {
      "src": "/consent-pdf.js",
      "dest": "/public/consent-pdf.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json"
    },
    {
      "src": "/manifest-fisio.json",
      "dest": "/public/manifest-fisio.json"
    },
    {
      "src": "/icono.png",
      "dest": "/icono.png"
    },
    {
      "src": "/privacidad",
      "dest": "/public/privacidad.html"
    },
    {
      "src": "/fisio",
      "dest": "/public/fisio.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron?resumen=1",
      "schedule": "0 7 * * *"
    }
  ]
}